{
  "name": "horarios-cepre-back-v1",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "prestart": "npm run prisma:generate",
    "start": "nest start",
    "prestart:dev": "npm run prisma:generate",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint \"{src,test}/**/*.ts\" \"*.config.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write src test docs \"*.{json,md,ts,mjs,cjs,yaml}\"",
    "format:check": "prettier --check src test docs \"*.{json,md,ts,mjs,cjs,yaml}\"",
    "pretest": "npm run prisma:generate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "test:e2e": "npm test -- --runTestsByPath test/app.e2e-spec.ts",
    "test:records": "npm test -- --runInBand --runTestsByPath test/class-session-records.e2e-spec.ts test/session-files.e2e-spec.ts src/modules/session-files/session-files.service.spec.ts src/modules/session-files/session-file.validation.spec.ts",
    "test:records:all": "node test/run-records-tests.cjs",
    "test:compatibility": "node test/compatibility/run.cjs",
    "test:production": "node test/compatibility/production.cjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "node dist/database/prisma/deploy.js",
    "prisma:studio": "prisma studio",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.3.1",
    "@google-cloud/storage": "7.16.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "jszip": "3.10.2",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/multer": "2.0.0",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "multer": "^2.5.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
