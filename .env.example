# Aplicación: estos valores son únicamente para desarrollo local.
NODE_ENV=development
PORT=8080
REDIRECT_FRONT=http://localhost:5173

# Conexión desde el host. Compose utiliza el hostname interno "db".
DATABASE_URL=postgresql://cepr:cepr_dev@localhost:5432/cepr
# Cada ORM tiene su propio pool con este máximo (10 conexiones en total con 5).
DB_POOL_MAX=5
# Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/redirect
GOOGLE_CLOUD_PROJECT=replace-with-project-id
FIRESTORE_DATABASE_ID=(default)
RUNTIME_CONFIG_CACHE_TTL_MS=15000
GCS_BUCKET=cepr-records-local
# Solo emulador local; omitir en producción para usar ADC y bucket privado.
STORAGE_EMULATOR_HOST=http://gcs:4443
CLASS_RECORDS_TASK_ENABLED=false

# PostgreSQL del entorno Compose. Mantenerlos alineados con DATABASE_URL.
POSTGRES_USER=cepr
POSTGRES_PASSWORD=cepr_dev
POSTGRES_DB=cepr
POSTGRES_PORT=5432
